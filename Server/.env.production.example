# ── App ─────────────────────────────────────────────────────────────
# development | production  (production disables /docs, forces HTTPS and hides captcha bypass)
APP_ENV=production
DEBUG=false
FRONTEND_URL=https://lscblack.tech
CORS_ORIGINS=https://lscblack.tech,https://www.lscblack.tech
# Public base URL for uploaded media (empty = the API's own origin)
MEDIA_BASE_URL=https://api.lscblack.tech
FORCE_HTTPS=true

# ── Database (PostgreSQL) ───────────────────────────────────────────
# Either a full URL (the database name may be omitted, DB_NAME is appended) …
DATABASE_URL=postgresql+psycopg://postgres:YourStrongPassword@127.0.0.1:5432/
# … or the parts (also used by deploy/deploy.sh)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourStrongPassword
DB_NAME=lscblack_portfolio
# Optional: shared cache + rate-limit counters between workers
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ────────────────────────────────────────────────────────────
# Long random string (openssl rand -hex 48). Required in production.
JWT_SECRET=REPLACE-WITH-openssl-rand-hex-48
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOGIN_MAX_FAILED=6
LOGIN_LOCK_MINUTES=15

# Default administrator (created once, when no admin exists)
DEFAULT_ADMIN_EMAIL=louesauveur18@gmail.com
DEFAULT_ADMIN_PASSWORD=Chriss@123
DEFAULT_ADMIN_NAME=Loue Sauveur Christian

# ── One-time passwords (second sign-in step, sent by email) ─────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Accounts allowed to use OTP_BYPASS_CODE instead of the emailed code. Leave the code empty to disable.
OTP_BYPASS_EMAIL=louesauveur18@gmail.com,sauveurloue2@gmail.com,louesauveur60@gmail.com
OTP_BYPASS_CODE=555555

# ── SMTP ────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_SERVER=mail.nexventures.net
EMAIL_SMTP_PORT=587
EMAIL_LOGIN=info@lscblack.tech
EMAIL_SENDER_EMAIL=info@lscblack.tech
EMAIL_SENDER_PASSWORD=Chriss@123
EMAIL_SENDER_NAME=lscblack portfolio
# Where contact-form notifications are delivered (empty = the admin email)
CONTACT_NOTIFY_EMAIL=

# ── Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30
MAX_VIDEO_UPLOAD_MB=80

# ── Captcha ─────────────────────────────────────────────────────────
# Dev-only bypass answer for the contact form (ignored when APP_ENV=production)
CAPTCHA_BYPASS_CODE=

# ── Security ────────────────────────────────────────────────────────
# Key for encrypting contact messages at rest (falls back to JWT_SECRET)
DATA_ENCRYPTION_KEY=
# Encrypted request/response envelope between the web app and the API (ECDH P-256 + AES-256-GCM)
PAYLOAD_ENCRYPTION=true
# Per-IP limits: requests/seconds
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_GLOBAL=300/60
# Public bootstrap cache lifetime (seconds); cleared automatically on every dashboard save
CACHE_TTL_SECONDS=120

GITHUB_USERNAME=lscblack
