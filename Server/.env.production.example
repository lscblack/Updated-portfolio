# ── Production environment — copy to .env.production and fill in, then run deploy/deploy.sh ──
# deploy.sh keeps APP_ENV, FRONTEND_URL, CORS_ORIGINS, FORCE_HTTPS, UPLOAD_DIR, MEDIA_BASE_URL,
# DATABASE_URL and the secrets in sync on every deploy — you only need the values below.

APP_ENV=production
DEBUG=false

# ── Database ────────────────────────────────────────────────────────────
# A dedicated role is recommended: if it does not exist yet, deploy.sh creates it
# (LOGIN CREATEDB) and the application creates + migrates its own database on start.
# Using DB_USER=postgres instead means sharing the superuser with every other app on the server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lscblack
DB_PASSWORD=REPLACE-ME-with-a-long-random-password
DB_NAME=lscblack_portfolio
# Optional but recommended with several workers: shared cache + rate-limit counters.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ────────────────────────────────────────────────────────────────
# Leave empty and deploy.sh generates one (openssl rand -hex 48). Changing it signs everyone out.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOGIN_MAX_FAILED=6
LOGIN_LOCK_MINUTES=15

# The administrator account, created once on the first start.
DEFAULT_ADMIN_EMAIL=louesauveur18@gmail.com
DEFAULT_ADMIN_PASSWORD=REPLACE-ME-before-the-first-deploy
DEFAULT_ADMIN_NAME=Loue Sauveur Christian

# ── One-time passwords (second sign-in factor, emailed) ─────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Must stay empty in production: a static bypass code would defeat the second factor.
# deploy.sh clears it unless you run the deploy with OTP_BYPASS_KEEP=1.
OTP_BYPASS_EMAIL=
OTP_BYPASS_CODE=

# ── SMTP (sign-in codes, contact + offer notifications) ─────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_SERVER=mail.nexventures.net
EMAIL_SMTP_PORT=587
EMAIL_LOGIN=info@lscblack.tech
EMAIL_SENDER_EMAIL=info@lscblack.tech
EMAIL_SENDER_PASSWORD=REPLACE-ME
EMAIL_SENDER_NAME=lscblack portfolio
# Where contact messages and offers are delivered (empty = the admin email).
CONTACT_NOTIFY_EMAIL=

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30
MAX_VIDEO_UPLOAD_MB=80

# ── Security ────────────────────────────────────────────────────────────
# Encrypts contact messages and offers at rest. Empty = deploy.sh generates one.
# Once data exists, changing it makes stored messages unreadable.
DATA_ENCRYPTION_KEY=
PAYLOAD_ENCRYPTION=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_GLOBAL=300/60
CACHE_TTL_SECONDS=120
# Cleared automatically in production.
CAPTCHA_BYPASS_CODE=

GITHUB_USERNAME=lscblack
